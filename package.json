{
  "name": "autoresearch-scaffold",
  "version": "1.0.0",
  "description": "A multi-agent research app backend scaffold for AutoResearch.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest",
    "dev:all": "concurrently \"npm run dev\" \"npm run web:dev\"",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.5.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.7",
    "@types/react-dom": "^18.2.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "clsx": "^2.0.0",
    "concurrently": "^9.2.0",
    "date-fns": "^3.3.1",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.8.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
